# Copier en .env et remplir. NE JAMAIS committer .env en clair.
# Les vrais secrets seront chiffrés via SOPS (voir .sops.yaml, à ajouter).

POSTGRES_USER=payments_app
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://payments_app:change_me@db:5432/payments

# Secret partagé auth<->payment-api (HS256). Mettre une vraie valeur aléatoire.
# ex: openssl rand -hex 32
JWT_SECRET=change_me_with_openssl_rand_hex_32

GRAFANA_PASSWORD=change_me

# Compte utilisé par le moteur de remédiation pour sa transaction de contrôle
CONTROL_PASSWORD=alice-pw

# Ollama : local sur le PC Hôte, ou http://<ip-3e-pc>:11434 si délestage
OLLAMA_URL=http://host.docker.internal:11434